<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Own launch configuration type: a JUnit launch that also runs @Disabled tests -->
   <extension point="org.eclipse.debug.core.launchConfigurationTypes">
      <launchConfigurationType
            id="io.github.christianlinzatti.rundisabled.launchConfigType"
            name="JUnit (inkl. @Disabled)"
            delegate="io.github.christianlinzatti.rundisabled.RunDisabledLaunchDelegate"
            delegateName="JUnit-Launcher inkl. @Disabled"
            delegateDescription="Startet JUnit-Tests und führt dabei auch mit @Disabled markierte Tests aus (auch @QuarkusTest)."
            modes="run, debug"
            allowCommandLine="true"
            sourceLocatorId="org.eclipse.jdt.launching.sourceLocator.JavaSourceLookupDirector"
            sourcePathComputerId="org.eclipse.jdt.launching.sourceLookup.javaSourcePathComputer">
      </launchConfigurationType>
   </extension>

   <extension point="org.eclipse.debug.ui.launchConfigurationTypeImages">
      <launchConfigurationTypeImage
            id="io.github.christianlinzatti.rundisabled.launchImage"
            configTypeID="io.github.christianlinzatti.rundisabled.launchConfigType"
            icon="icons/run_disabled.png">
      </launchConfigurationTypeImage>
   </extension>

   <extension point="org.eclipse.debug.ui.launchConfigurationTabGroups">
      <launchConfigurationTabGroup
            id="io.github.christianlinzatti.rundisabled.tabGroup"
            type="io.github.christianlinzatti.rundisabled.launchConfigType"
            class="io.github.christianlinzatti.rundisabled.RunDisabledTabGroup">
         <launchMode mode="run" description="JUnit-Tests inkl. @Disabled ausführen"/>
         <launchMode mode="debug" perspective="org.eclipse.debug.ui.DebugPerspective"
               description="JUnit-Tests inkl. @Disabled debuggen"/>
      </launchConfigurationTabGroup>
   </extension>

   <!-- Run As / Debug As > JUnit Test (inkl. @Disabled) -->
   <extension point="org.eclipse.debug.ui.launchShortcuts">
      <shortcut
            id="io.github.christianlinzatti.rundisabled.shortcut"
            class="io.github.christianlinzatti.rundisabled.RunDisabledLaunchShortcut"
            label="JUnit Test (inkl. @Disabled)"
            icon="icons/run_disabled.png"
            modes="run, debug">
         <contextualLaunch>
            <enablement>
               <with variable="selection">
                  <count value="1"/>
                  <iterate>
                     <adapt type="org.eclipse.jdt.core.IJavaElement">
                        <and>
                           <test property="org.eclipse.jdt.core.isInJavaProject"/>
                           <test property="org.eclipse.jdt.core.hasTypeOnClasspath" value="org.junit.platform.commons.annotation.Testable"/>
                           <test property="org.eclipse.jdt.junit.canLaunchAsJUnit" forcePluginActivation="true"/>
                        </and>
                     </adapt>
                  </iterate>
               </with>
            </enablement>
         </contextualLaunch>
         <configurationType id="io.github.christianlinzatti.rundisabled.launchConfigType"/>
         <description mode="run" description="JUnit-Tests inkl. @Disabled ausführen"/>
         <description mode="debug" description="JUnit-Tests inkl. @Disabled debuggen"/>
      </shortcut>
   </extension>

   <!-- ${run_disabled_agent} for use in any launch configuration: -javaagent:${run_disabled_agent} -->
   <extension point="org.eclipse.core.variables.dynamicVariables">
      <variable
            name="run_disabled_agent"
            description="Pfad zum Java-Agent, der @Disabled ignoriert (VM-Argument: -javaagent:${run_disabled_agent})"
            resolver="io.github.christianlinzatti.rundisabled.AgentVariableResolver"
            supportsArgument="false">
      </variable>
   </extension>

   <!-- JUnit view context menu: Run / Debug (inkl. @Disabled) -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="io.github.christianlinzatti.rundisabled.category"
            name="JUnit (inkl. @Disabled)">
      </category>
      <command
            id="io.github.christianlinzatti.rundisabled.junitView.run"
            categoryId="io.github.christianlinzatti.rundisabled.category"
            name="Run (inkl. @Disabled)"
            description="Ausgewählten Test inkl. @Disabled erneut ausführen">
      </command>
      <command
            id="io.github.christianlinzatti.rundisabled.junitView.debug"
            categoryId="io.github.christianlinzatti.rundisabled.category"
            name="Debug (inkl. @Disabled)"
            description="Ausgewählten Test inkl. @Disabled erneut debuggen">
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="io.github.christianlinzatti.rundisabled.junitView.run"
            class="io.github.christianlinzatti.rundisabled.JUnitViewLaunchHandler$Run">
      </handler>
      <handler
            commandId="io.github.christianlinzatti.rundisabled.junitView.debug"
            class="io.github.christianlinzatti.rundisabled.JUnitViewLaunchHandler$Debug">
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.jdt.junit.ResultView?after=additions">
         <command
               commandId="io.github.christianlinzatti.rundisabled.junitView.run"
               label="Run (inkl. @Disabled)"
               icon="icons/run_disabled.png"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <count value="1"/>
                  <iterate ifEmpty="false">
                     <instanceof value="org.eclipse.jdt.junit.model.ITestElement"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="io.github.christianlinzatti.rundisabled.junitView.debug"
               label="Debug (inkl. @Disabled)"
               icon="icons/run_disabled.png"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <count value="1"/>
                  <iterate ifEmpty="false">
                     <instanceof value="org.eclipse.jdt.junit.model.ITestElement"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
